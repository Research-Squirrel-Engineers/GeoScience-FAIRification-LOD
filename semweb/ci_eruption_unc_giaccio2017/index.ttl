@prefix ns1: <http://w3id.org/geo-lod/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix void: <http://rdfs.org/ns/void#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ns1:ci_eruption_unc_giaccio2017 a ns1:AgeUncertainty,
        <http://www.w3.org/ns/ldp#Resource>,
        <https://www.iana.org/assignments/media-types/text/turtle#Resource> ;
    rdfs:label "Uncertainty of 39.85 ± 0.14 ka (40Ar/39Ar, 95% confidence level)"@en ;
    void:inDataset ns1:geo-lod ;
    ns1:coverageLevel 0.95 ;
    ns1:hasAgeInterval ns1:ci_eruption_interval_giaccio2017 ;
    ns1:minusKa 0.14 ;
    ns1:plusKa 0.14 .

