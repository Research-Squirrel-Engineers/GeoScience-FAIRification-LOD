@prefix ns1: <http://w3id.org/geo-lod/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix void: <http://rdfs.org/ns/void#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ns1:ci_eruption_unc_schenk2024 a ns1:AgeUncertainty,
        <http://www.w3.org/ns/ldp#Resource>,
        <https://www.iana.org/assignments/media-types/text/turtle#Resource> ;
    rdfs:label "Uncertainty of 39,940 ± 150 yr b2k (ELSA-20 chronology)"@en ;
    void:inDataset ns1:geo-lod ;
    ns1:hasAgeInterval ns1:ci_eruption_interval_schenk2024 ;
    ns1:minusKa 0.150 ;
    ns1:plusKa 0.150 .

