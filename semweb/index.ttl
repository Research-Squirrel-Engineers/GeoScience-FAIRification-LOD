ns1:ci_eruption_dating_devivo2001 a ns4:E13_Attribute_Assignment,
        <http://www.w3.org/ns/ldp#BasicContainer>,
        <http://www.w3.org/ns/ldp#Container>,
        <http://www.w3.org/ns/ldp#Resource>,
        prov:Entity ;
    rdfs:label "40Ar/39Ar age of the CI eruption, De Vivo et al. (2001)"@en ;
    dcterms:bibliographicCitation "De Vivo, B., Rolandi, G., Gans, P.B., Calvert, A., Bohrson, W.A., Spera, F.J., Belkin, H.E. (2001). New constraints on the pyroclastic eruptive history of the Campanian volcanic Plain (Italy). Mineralogy and Petrology 73, 47-65." ;
    void:inDataset ns1:geo-lod ;
    ns4:P140_assigned_attribute_to ns1:ci_eruption_timespan ;
    ns4:P141_assigned ns1:ci_eruption_tp_devivo2001 ;
    rdfs:comment "Earlier 40Ar/39Ar age, about 2 ka older than the previous best estimate at the time and younger than the 2017 age. Kept as a competing assertion, not as the adopted one."@en ;
    prov:wasDerivedFrom <https://doi.org/10.1007/s007100170010> .

ns1:ci_eruption_dating_giaccio2017 a ns4:E13_Attribute_Assignment,
        <http://www.w3.org/ns/ldp#BasicContainer>,
        <http://www.w3.org/ns/ldp#Container>,
        <http://www.w3.org/ns/ldp#Resource>,
        prov:Entity ;
    rdfs:label "40Ar/39Ar age of the CI eruption, Giaccio et al. (2017)"@en ;
    dcterms:bibliographicCitation "Giaccio, B., Hajdas, I., Isaia, R., Deino, A., Nomade, S. (2017). High-precision 14C and 40Ar/39Ar dating of the Campanian Ignimbrite (Y-5) reconciles the time-scales of climatic-cultural processes at 40 ka. Scientific Reports 7, 45940." ;
    void:inDataset ns1:geo-lod ;
    ns4:P140_assigned_attribute_to ns1:ci_eruption_timespan ;
    ns4:P141_assigned ns1:ci_eruption_tp_giaccio2017 ;
    rdfs:comment "Direct 40Ar/39Ar age of the eruption. The same study gives 34.29 ± 0.09 14C kyr BP (1σ), which is not calendar-calibrated and is not stored as ka BP here."@en ;
    skos:note "Adopted as the age of the event: the direct 40Ar/39Ar age of the eruption that Schenk et al. (2024) call the latest."@en ;
    prov:wasDerivedFrom <https://doi.org/10.1038/srep45940> .

ns1:ci_eruption_dating_schenk2024 a ns4:E13_Attribute_Assignment,
        <http://www.w3.org/ns/ldp#BasicContainer>,
        <http://www.w3.org/ns/ldp#Container>,
        <http://www.w3.org/ns/ldp#Resource>,
        prov:Entity ;
    rdfs:label "Modelled age of the CI cryptotephra in the Auel core, Schenk et al. (2024)"@en ;
    dcterms:bibliographicCitation "Schenk, F., Hambach, U., Britzius, S., Veres, D., Sirocko, F. (2024). A Cryptotephra Layer in Sediments of an Infilled Maar Lake from the Eifel (Germany): First Evidence of Campanian Ignimbrite Ash Airfall in Central Europe. Quaternary 7(2), 17." ;
    void:inDataset ns1:geo-lod ;
    ns4:P140_assigned_attribute_to ns1:ci_eruption_timespan ;
    ns4:P141_assigned ns1:ci_eruption_tp_schenk2024 ;
    rdfs:comment "Fallout age of the CI tephra at Auel (Eifel) in the ELSA-20 chronology, almost identical to the latest 40Ar/39Ar dates. It dates the layer in one core, not the vent."@en ;
    prov:wasDerivedFrom <https://doi.org/10.3390/quat7020017> .

