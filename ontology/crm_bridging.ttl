# ============================================================================
# crm_bridging.ttl
# geo-lod ↔ CIDOC-CRM Bridging Axioms
# <http://w3id.org/geo-lod/crm-bridging>
#
# Purpose
#   Anchors every external standard vocabulary that is instantiated in the
#   geo-lod knowledge graph (EPICA + SISAL + CI) into the CIDOC-CRM family,
#   so that all instances are reachable from a CRM-family class via the
#   transitive closure of rdfs:subClassOf.
#
#   This is required for ingestion into the NFDI4Objects Knowledge Graph,
#   which mandates a CRM-family ancestor for every typed instance.
#
# Crosswalk
#   See ontology/README.md (section 2.2) for the rationale behind each
#   mapping and the open questions / decisions still to be made.
#
# Validation
#   The CRM-coverage check in bundle_rdf.py enforces that every typed
#   instance has a CRM-family ancestor. This file is loaded as part of
#   ontology/*.ttl and contributes the bridging axioms.
# ============================================================================

@prefix crm:        <http://www.cidoc-crm.org/cidoc-crm/> .
@prefix crmsci:     <http://www.ics.forth.gr/isl/CRMsci/> .
@prefix crmgeo:     <http://www.ics.forth.gr/isl/CRMgeo/> .
@prefix crmarchaeo: <http://www.cidoc-crm.org/extensions/crmarchaeo/> .

@prefix sosa:       <http://www.w3.org/ns/sosa/> .
@prefix prov:       <http://www.w3.org/ns/prov#> .
@prefix geo:        <http://www.opengis.net/ont/geosparql#> .
@prefix sf:         <http://www.opengis.net/ont/sf#> .
@prefix dcat:       <http://www.w3.org/ns/dcat#> .
@prefix skos:       <http://www.w3.org/2004/02/skos/core#> .
@prefix time:       <http://www.w3.org/2006/time#> .
@prefix dcterms:    <http://purl.org/dc/terms/> .
@prefix foaf:       <http://xmlns.com/foaf/0.1/> .
@prefix pleiades:   <https://pleiades.stoa.org/places/vocab#> .
@prefix strat:      <http://w3id.org/geo-lod/strat/> .
@prefix an:         <http://w3id.org/geo-lod/analysis/> .
@prefix fuzzysl:    <http://fuzzy-sl.squirrel.link/ontology/> .

@prefix rdfs:       <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:        <http://www.w3.org/2002/07/owl#> .
@prefix dct:        <http://purl.org/dc/terms/> .

# ============================================================================
# Ontology header
# ============================================================================

<http://w3id.org/geo-lod/crm-bridging>
    a owl:Ontology ;
    rdfs:label   "geo-lod ↔ CIDOC-CRM Bridging Axioms"@en ;
    rdfs:comment """Bridges external standard vocabularies (SOSA, PROV-O, GeoSPARQL, DCAT, FOAF, Dublin Core, Pleiades, fuzzy-sl) into the CIDOC-CRM family so that every instance in the geo-lod knowledge graph has a CRM-family ancestor. Required for ingestion into the NFDI4Objects Knowledge Graph."""@en ;
    owl:imports  <http://w3id.org/geo-lod/> ;
    dct:created  "2026-04"^^<http://www.w3.org/2001/XMLSchema#gYearMonth> .

# ============================================================================
# SOSA  →  CRMsci
# ============================================================================
# Sensor, Observation, Sample and Actuator Ontology aligned with the
# scientific-observation pattern in CRMsci.
# https://www.w3.org/TR/vocab-ssn/

sosa:Observation
    rdfs:subClassOf crmsci:S4_Observation .

sosa:Sample
    rdfs:subClassOf crm:E18_Physical_Thing .

sosa:ObservableProperty
    rdfs:subClassOf crmsci:S9_Property_Type .

sosa:Procedure
    rdfs:subClassOf crm:E29_Design_or_Procedure .

# ============================================================================
# PROV-O  →  CRM
# ============================================================================
# W3C provenance ontology - direct alignment to CRM core entity/event/actor.
# https://www.w3.org/TR/prov-o/

prov:Entity
    rdfs:subClassOf crm:E70_Thing .

prov:Activity
    rdfs:subClassOf crm:E7_Activity .

prov:Agent
    rdfs:subClassOf crm:E39_Actor .

# ============================================================================
# FOAF  →  CRM
# ============================================================================
# Friend-of-a-Friend - persons.

foaf:Person
    rdfs:subClassOf crm:E21_Person .

# ============================================================================
# GeoSPARQL / Simple Features  →  CRM / CRMgeo
# ============================================================================
# OGC standards for spatial data.
# https://www.ogc.org/standards/geosparql

geo:Feature
    rdfs:subClassOf crm:E1_CRM_Entity .

geo:FeatureCollection
    rdfs:subClassOf crm:E78_Curated_Holding .

sf:Point
    rdfs:subClassOf crmgeo:SP6_Declarative_Place .

# ============================================================================
# DCAT / Dublin Core  →  CRM
# ============================================================================
# Dataset and document description.

dcat:Dataset
    rdfs:subClassOf crm:E73_Information_Object .

dcat:Catalog
    rdfs:subClassOf crm:E78_Curated_Holding .

dcterms:BibliographicResource
    rdfs:subClassOf crm:E31_Document .

# ============================================================================
# Pleiades / fuzzy-sl  →  CRM
# ============================================================================
# Gazetteer (Pleiades) and squirrel.link Site model.

pleiades:Place
    rdfs:subClassOf crm:E53_Place .

fuzzysl:Site
    rdfs:subClassOf crm:E27_Site .

fuzzysl:Georeferencing
    rdfs:subClassOf crm:E13_Attribute_Assignment .

# ============================================================================
# SKOS  →  CRM
# ============================================================================
# Controlled vocabularies. A concept is a term of a vocabulary, a scheme the
# authority document that publishes it.
# https://www.w3.org/TR/skos-reference/

skos:Concept
    rdfs:subClassOf crm:E55_Type .

skos:ConceptScheme
    rdfs:subClassOf crm:E32_Authority_Document .

skos:Collection
    rdfs:subClassOf crm:E78_Curated_Holding .

# ============================================================================
# OWL-Time  →  CRM
# ============================================================================
# A time position is a quantified value with a unit and a reference system,
# which is what E54 describes; the reference system itself is a declarative
# procedure, mirroring crmgeo:SP4 for spatial coordinate reference systems.
# https://www.w3.org/TR/owl-time/

time:TimePosition
    rdfs:subClassOf crm:E54_Dimension .

time:TRS
    rdfs:subClassOf crm:E29_Design_or_Procedure .

# ============================================================================
# strat: / an:  →  CRM
# ============================================================================
# The two Layer-1 modules moved into geo-lod with S3c.3. They are deliberately
# CRM-free so that wdttest-tables can keep importing them unchanged; the
# anchoring lives here, which is the same split the WD1 family used between
# strat.ttl and its own crm_bridge.ttl.
#
# Every class of strat: is anchored, instantiated here or not. The N4O rule is
# that nothing in the graph may lack a CRM-family ancestor, and a class that is
# declared but unanchored is a gap in the ontology whatever its data say. Where
# the merge with geolod: (S4) moves a class, its axiom moves with it. The
# subclasses LithologicalUnit and TephraLayer inherit the anchor of
# StratigraphicUnit and need no axiom of their own.

strat:AgeControlPoint
    rdfs:subClassOf crm:E13_Attribute_Assignment .

# A dated tie point assigns an age to a depth. E13 rather than crmsci:S21,
# because SISAL states two kinds under one heading: 1177 laboratory
# measurements and two observations that the speleothem is still growing.
# Both constrain the age-depth model, only the first is a measurement, and
# geolod:datingMethod says which is which.

# ---- the rest of strat: ---------------------------------------------------

# A body of sediment in a core is a volume of matter with a place in the
# stratigraphic sequence, which is what A2 is. The comment in strat.ttl names
# the same class.
strat:StratigraphicUnit
    rdfs:subClassOf crmarchaeo:A2_Stratigraphic_Volume_Unit .

# The contact between two units; strat.ttl names A3 as the counterpart.
strat:Boundary
    rdfs:subClassOf crmarchaeo:A3_Stratigraphic_Interface .

# An eruption is a natural event, which E5 covers. It carries the age of the
# tephra it produced.
strat:Eruption
    rdfs:subClassOf crm:E5_Event .

# The drill core is a piece of matter taken from the ground for examination,
# which is S13 Sample. It is the physical counterpart of geolod:IceCore
# (E22), which stays a human-made object because an ice core is cut and
# stored by people.
strat:Core
    rdfs:subClassOf crmsci:S13_Sample .

# The age-depth model is the result of evaluating dated tie points, the same
# reading as geolod:AgeModel (S6). When S4 merges the two classes this axiom
# and the one for geolod:AgeModel become one.
strat:AgeDepthModel
    rdfs:subClassOf crmsci:S6_Data_Evaluation .


